# Legacy storage folder
storage/storage/*.json

# INCLUDE ESSENTIAL DATA FILES FOR DEPLOYMENT
# Override previous exclusions for data files
!data/
!data/metadata/
!data/metadata/*.jsonl
!data/embeddings/
!data/embeddings/*/
!data/embeddings/*/*.faiss
!data/embeddings/*/*.jsonl

# Still exclude these large/unnecessary data files
data/pdf_full_text/
data/pdf_metadata/
data/processed_register/.DS_Store
